# Copy to .env and fill in. Never commit a real .env.
PAGE_ID=
PAGE_ACCESS_TOKEN=
VERIFY_TOKEN=
META_APP_SECRET=
MESSENGER_API_VERSION=v21.0

# Meta Model API (Llama) - only LLM in this edition
META_MODEL_API_KEY=
META_MODEL_API_BASE=https://api.meta.ai/v1
LLAMA_MODEL_NAME=muse-spark-1.2
LLAMA_FALLBACK_MODELS=muse-spark-1.1,muse-spark-1.3

META_VISION_MODEL=muse-spark-1.3

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_TELEGRAM_USER_IDS=

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Business rules (hard limits that override the AI)
MAX_DISCOUNT_PCT=10
REFUND_REQUIRES_HUMAN=true
AI_CAN_CANCEL_ORDER=false
AI_CAN_MODIFY_ADDRESS=false
MIN_ORDER_VALUE=300
COD_ENABLED=true
DELIVERY_CHARGE_DHAKA=60
DELIVERY_CHARGE_OUTSIDE=120
RETURN_WINDOW_DAYS=7
MAX_FOLLOWUPS_PER_WEEK=2
ADMIN_TELEGRAM_USER_IDS=

CATALOG_USD_BDT_RATE=
PORT=5000
DEBUG=false
SYSTEM_PROMPT=
